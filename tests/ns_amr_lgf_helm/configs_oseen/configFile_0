simulation_parameters
{
    nLevels=0;

    // --- Lamb-Oseen vortex, analytic verification -----------------------
    Vort_type=2;          // 2 = Lamb-Oseen  (ctor -> initialize())
    Ux=0.0;               // no frame velocity: vortex stays on the origin
    L_z=1.0;              // z period (Fourier); mode 0 only for a 2D vortex
    error_radius=3.0;     // evaluate the L_inf error only within r <= 3 (LGF/FMM velocity is accurate there; the 1/r tail is truncated further out)

    // Time Marching (a few steps)
    source_max=13.0;
    nBaseLevelTimeSteps=4;
    cfl = 0.35;
    cfl_max = 1000;
    Re = 1000.0;
    refinement_factor=0.125;
    R=0.5;
    adapt_frequency=100000;   // never adapt: keep the mesh frozen
    output_frequency=4;
    base_level_threshold=1e-4;
    hard_max_refinement=true;

    single_ring=true;
    perturbation=false;
    vDelta=0.2;
    fat_ring=true;

    hdf5_ref_name=null;       // analytic reference, no stored file

    output
    {
        directory=output;
    }

    restart_write_frequency=20;
    write_restart=false;
    use_restart=false;

    restart
    {
        load_directory=restart;
        save_directory=restart;
    }

    domain
    {

        bd_base = (-24,-24,-24);
        bd_extent = (48,48,48);


        dx_base=0.25;

        block_extent=6;

        block
        {
            base=(-24,-24,-24);
            extent=(48,48,48);
        }
    }
    EXP_LInf=0.02;   // measured Linf ~0.0076 (config_0, dx=0.25, 4 steps)
}
